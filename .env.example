# The published port is loopback-only by default. Change this deliberately if
# another machine must reach the service, and add your own network controls.
DEMIRROR_BIND_ADDRESS=127.0.0.1
DEMIRROR_PORT=8765
DEMIRROR_MEMORY_LIMIT=4g

# Optional base URL used only for fixed Hugging Face detector assets, for
# example https://hf-mirror.com. Other assets stay on their official hosts.
DEMIRROR_HUGGINGFACE_ENDPOINT=

# Use the published GHCR image, or replace this with another immutable tag.
DEMIRROR_IMAGE=ghcr.io/fan1k413/demirror:latest

# Set to 0 for a smaller core-only local build. Published images use 1.
DEMIRROR_INSTALL_OPTIONAL_DETECTORS=1

# Optional integrations. Keep secrets in the local .env file; it is ignored by Git.
OPENAI_API_KEY=
GOOGLE_SYNTHID_MANUAL_ENABLED=0
DEMIRROR_GEOMETRY_PERSPECTIVE_FIELDS=0
