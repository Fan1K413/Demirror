  "execution": {
    "device": "cpu",
    "cpu_threads": 2,
    "model_isolation": "one short-lived Python process per candidate",
    "image_batch_size": 1,
    "maximum_peak_working_set_mib": 750,
    "maximum_p95_seconds_per_scored_view": 2.0,
    "fail_on_nonfinite_score": true,
    "fail_on_input_hash_mismatch": true,
    "strict_checkpoint_load_required": true
  },
  "elimination_gate": {
    "applies_to_each_original_and_jpeg85_profile": true,
    "openfake_generated_recall_wilson_95_lower_minimum": 0.55,
    "each_generator_point_recall_minimum": 0.45,
    "pooled_real_false_positive_rate_wilson_95_upper_maximum": 0.25,
    "openfake_additional_generated_hits_over_registered_baseline_minimum": 8,
    "jpeg85_generated_recall_drop_maximum": 0.10,
    "jpeg85_pooled_real_false_positive_rate_increase_maximum": 0.05,
    "original_jpeg85_binary_agreement_minimum": 0.85,
    "patchcraft_cross_seed_binary_agreement_minimum": 0.95,
    "patchcraft_cross_seed_score_range_p95_maximum": 0.15,
    "all_resource_limits_must_pass": true,
    "threshold_tuning_allowed": false
  },
  "decision_policy": {
    "any_gate_failure": "reject_candidate_for_product_integration",
    "all_gates_pass": "eligible_only_for_license_resolution_and_a_larger_source-isolated_blind_gate",
    "deployment_always_blocked_in_this_screen": true,
    "website_and_origin_scoring_must_remain_unchanged": true
  }
}
